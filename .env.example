# Application
APP_NAME=FQ-SaaS
DEBUG=False

# Auth / JWT
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fqsaas

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Provider
# Options: mock, minimax, openai, ollama
LLM_PROVIDER=mock

# MiniMax API
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1/chat/completions

# OpenAI API
OPENAI_API_KEY=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

# Model routing
DEFAULT_MODEL=qwen3-14b
IT_MODEL=qwen3-235b

# Default quotas
DEFAULT_MAX_TOKENS_PER_DAY=50000
DEFAULT_MAX_REQUESTS_PER_DAY=200

# Encryption
FERNET_KEY=change-me-in-production

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
