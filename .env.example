# Application
APP_NAME=FQ-SaaS
DEBUG=False

# Auth / JWT
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fqsaas

# Redis
REDIS_URL=redis://localhost:6379/0
KPI_TOKEN_ALERT_THRESHOLD=40000
KPI_COST_ALERT_THRESHOLD=25

# LLM Provider
# Options: mock, minimax, openai, ollama
LLM_PROVIDER=mock

# MiniMax API
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1/chat/completions

# OpenAI API
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

# Model routing
DEFAULT_MODEL=qwen3-14b
IT_MODEL=qwen3-235b

# Default quotas
DEFAULT_MAX_TOKENS_PER_DAY=50000
DEFAULT_MAX_REQUESTS_PER_DAY=200

# Encryption
FERNET_KEY=change-me-in-production

# Hermes runtime / orchestrator
HERMES_ORCHESTRATOR_URL=
HERMES_ORCHESTRATOR_SECRET=change-me-to-a-long-random-shared-secret
HERMES_ORCHESTRATOR_REQUIRE_SECRET=true
HERMES_IMAGE=ghcr.io/hermes-agent/hermes:latest
HERMES_PORT=8787
HERMES_INTERNAL_URL=http://agent-saas-hermes:8787
HERMES_RUN_PATH=/runs
HERMES_RUN_STREAM_PATH=/runs/stream
HERMES_HEALTH_PATH=/health
AGENTSAAS_DOCKER_NETWORK=agentsaas_private

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
