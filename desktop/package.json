{
  "name": "fq-saas-desktop",
  "version": "1.0.0",
  "description": "FQ-SaaS Desktop Client",
  "author": "FQ-SaaS",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --config electron-builder.js",
    "build:mac": "electron-builder --config electron-builder.js --mac dmg zip",
    "build:release": "electron-builder --config electron-builder.js --publish never",
    "build:release:mac": "electron-builder --config electron-builder.js --mac dmg zip --publish never",
    "release:check": "node ./scripts/release-check.js"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3"
  }
}
