FROM node:20-alpine

WORKDIR /app

ARG NEXT_PUBLIC_API_URL=/api
ARG NEXT_PUBLIC_API_ORIGIN=http://api:8000
ARG NEXT_PUBLIC_DESKTOP_WINDOWS_DOWNLOAD_URL=
ARG NEXT_PUBLIC_DESKTOP_MAC_DOWNLOAD_URL=
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_API_ORIGIN=${NEXT_PUBLIC_API_ORIGIN}
ENV NEXT_PUBLIC_DESKTOP_WINDOWS_DOWNLOAD_URL=${NEXT_PUBLIC_DESKTOP_WINDOWS_DOWNLOAD_URL}
ENV NEXT_PUBLIC_DESKTOP_MAC_DOWNLOAD_URL=${NEXT_PUBLIC_DESKTOP_MAC_DOWNLOAD_URL}

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

EXPOSE 3000

CMD ["npm", "run", "start", "--", "-H", "0.0.0.0"]
