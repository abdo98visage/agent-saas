# Paste these values into Hostinger Docker Manager environment variables.
# Do not commit a copy containing real secrets.

TRAEFIK_HOST=ai.example.com

AGENTSAAS_API_IMAGE=ghcr.io/abdo98visage/agent-saas/api:1.0.0
AGENTSAAS_ADMIN_IMAGE=ghcr.io/abdo98visage/agent-saas/admin:1.0.0
AGENTSAAS_HERMES_RUNTIME_IMAGE=ghcr.io/abdo98visage/agent-saas/runtime:1.0.0
AGENTSAAS_POSTGRES_IMAGE=postgres:15-alpine
AGENTSAAS_REDIS_IMAGE=redis:7-alpine
AGENTSAAS_DATA_DIR=/opt/agentsaas/data

POSTGRES_USER=agentsaas
# Use a long URL-safe value: letters, numbers, underscore and hyphen only.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
POSTGRES_DB=agentsaas

SECRET_KEY=replace-with-at-least-32-random-characters
FERNET_KEY=replace-with-a-valid-fernet-key
HERMES_ORCHESTRATOR_SECRET=replace-with-at-least-32-random-characters
HERMES_RUNTIME_SECRET=replace-with-a-different-32-character-secret
METRICS_TOKEN=replace-with-a-long-random-token

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-initial-password
MINIMAX_API_KEY=replace-with-the-platform-minimax-key

