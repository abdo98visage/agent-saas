FROM python:3.11-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl xz-utils nodejs npm \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && hermes --version

COPY . .

EXPOSE 8787

CMD ["uvicorn", "app.local_hermes_runtime_app:app", "--host", "0.0.0.0", "--port", "8787"]
