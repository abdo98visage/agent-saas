# Copy to .env.production and replace every value before deployment.

APP_NAME=FQ-SaaS
DEBUG=False
ENVIRONMENT=production
ALLOWED_ORIGINS=["https://your-domain.example"]
PUBLIC_APP_ORIGIN=https://your-domain.example
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_DESKTOP_WINDOWS_DOWNLOAD_URL=https://downloads.example.com/FQ-SaaS-Workspace-Setup-1.0.0.exe
NEXT_PUBLIC_DESKTOP_MAC_DOWNLOAD_URL=https://downloads.example.com/FQ-SaaS-Workspace-1.0.0-universal.dmg

SECRET_KEY=replace-with-at-least-32-random-characters
FERNET_KEY=replace-with-a-fernet-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

POSTGRES_USER=agentsaas
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=agentsaas
DATABASE_URL=postgresql+asyncpg://agentsaas:replace-with-strong-postgres-password@db:5432/agentsaas
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10
WEBSOCKET_MAX_MESSAGE_BYTES=8388608
ATTACHMENT_STORAGE_ROOT=/data/attachments
KPI_TOKEN_ALERT_THRESHOLD=40000
KPI_COST_ALERT_THRESHOLD=25

LLM_PROVIDER=minimax
DEFAULT_MODEL=MiniMax-M3
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1/chat/completions
OPENAI_API_KEY=
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://ollama:11434

HERMES_ORCHESTRATOR_URL=http://hermes-orchestrator:8788
HERMES_ORCHESTRATOR_SECRET=replace-with-long-random-shared-secret
HERMES_ORCHESTRATOR_REQUIRE_SECRET=true
HERMES_RUNTIME_SECRET=replace-with-a-different-long-random-runtime-secret
HERMES_PORT=8787
HERMES_INTERNAL_URL=http://hermes-runtime:8787
HERMES_RUN_PATH=/runs
HERMES_RUN_STREAM_PATH=/runs/stream
HERMES_HEALTH_PATH=/health

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://your-domain.example/api/telegram/webhook

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
METRICS_TOKEN=replace-with-a-long-random-metrics-token
AUDIT_EXPORT_URL=
AUDIT_EXPORT_TOKEN=
KNOWLEDGE_ALLOWED_ROOTS=["/data/knowledge"]
SENTRY_TRACES_SAMPLE_RATE=0.1

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@your-domain.example
ALERT_NOTIFICATION_EMAILS=ops@your-domain.example
ALERT_NOTIFICATION_COOLDOWN_MINUTES=60
AGENTSAAS_BACKUP_RECIPIENT=ops-backup-key@example.com
AGENTSAAS_API_IMAGE=registry.example.com/agentsaas-api@sha256:replace-with-digest
AGENTSAAS_ADMIN_IMAGE=registry.example.com/agentsaas-admin@sha256:replace-with-digest
AGENTSAAS_HERMES_RUNTIME_IMAGE=registry.example.com/agentsaas-runtime@sha256:replace-with-digest
AGENTSAAS_CADDY_IMAGE=registry.example.com/caddy@sha256:replace-with-digest
AGENTSAAS_POSTGRES_IMAGE=registry.example.com/postgres@sha256:replace-with-digest
AGENTSAAS_REDIS_IMAGE=registry.example.com/redis@sha256:replace-with-digest
